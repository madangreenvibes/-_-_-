if (!function_exists('sc_get')) {
    function sc_get() {
        $d = get_option('setopress_npl_data');
        if (!is_array($d)) $d = array('series' => array(), 'matches' => array(), 'news' => array());
        if (!isset($d['series'])) $d['series'] = array();
        if (!isset($d['matches'])) $d['matches'] = array();
        if (!isset($d['news'])) $d['news'] = array();
        return $d;
    }
}

if (!function_exists('sc_load_npl_defaults')) {
    function sc_load_npl_defaults() {
        $d   = sc_get();
        $sn  = SC_NPL_SERIES;
        $old = $d['series'][$sn] ?? array();
        $list = array(
            'Biratnagar Kings', 'Chitwan Rhinos', 'Janakpur Bolts', 'Karnali Yaks',
            'Kathmandu Gurkhas', 'Lumbini Lions', 'Pokhara Avengers', 'Sudurpaschim Royals'
        );
        $teams = array();
        foreach ($list as $tn) {
            $p = $old['teams'][$tn] ?? array();
            $teams[$tn] = array(
                'name' => $tn, 'logo' => $p['logo'] ?? '', 'color' => $p['color'] ?? '#c8102e',
                'captain' => $p['captain'] ?? '', 'coach' => $p['coach'] ?? '',
                'owner' => $p['owner'] ?? '', 'venue' => $p['venue'] ?? '',
                'titles' => $p['titles'] ?? '', 'description' => $p['description'] ?? '',
                'players' => $p['players'] ?? array()
            );
        }
        if (isset($teams['Biratnagar Kings']) && empty($teams['Biratnagar Kings']['description'])) {
            $teams['Biratnagar Kings']['description'] = 'Representing Koshi Province in the Nepal Premier League.';
            $teams['Biratnagar Kings']['color']       = '#c8102e';
        }
        $d['series'][$sn] = array(
            'name' => $sn, 'format' => 'T20', 'season' => '2026',
            'logo' => $old['logo'] ?? '', 'teams' => $teams
        );
        update_option('setopress_npl_data', $d);
    }
}

if (!function_exists('sc_logo')) {
    function sc_logo($s, $t) {
        $ts = $s['teams'] ?? array();
        if (!empty($ts[$t]['logo'])) return $ts[$t]['logo'];
        foreach ($ts as $r) if (strcasecmp($r['name'], $t) === 0 && !empty($r['logo'])) return $r['logo'];
        return '';
    }
}

if (!function_exists('sc_team_color')) {
    function sc_team_color($s, $t) {
        $ts = $s['teams'] ?? array();
        if (!empty($ts[$t]['color'])) return $ts[$t]['color'];
        foreach ($ts as $r) if (strcasecmp($r['name'], $t) === 0 && !empty($r['color'])) return $r['color'];
        return '#c8102e';
    }
}

if (!function_exists('sc_format_datetime_full')) {
    function sc_format_datetime_full($d, $t) {
        if (empty($d)) return '';
        $ts = strtotime($d . (empty($t) ? '' : ' ' . $t));
        if (!$ts) return $d;
        return date('D, j M Y, g:i A', $ts);
    }
}

if (!function_exists('sc_merge_players')) {
    function sc_merge_players($players) {
        $merged = array();
        foreach ($players as $p) {
            $name  = trim($p['name']  ?? '');
            $role  = trim($p['role']  ?? '');
            $photo = trim($p['photo'] ?? '');
            if (empty($name)) continue;
            if (!isset($merged[$name])) $merged[$name] = array('name' => $name, 'roles' => array(), 'photo' => $photo);
            if (!empty($role) && !in_array($role, $merged[$name]['roles'])) $merged[$name]['roles'][] = $role;
            if (!empty($photo) && empty($merged[$name]['photo'])) $merged[$name]['photo'] = $photo;
        }
        return array_values($merged);
    }
}

if (!function_exists('sc_parse_overs')) {
    function sc_parse_overs($ov_str) {
        if (empty($ov_str)) return 0;
        $ov_str = trim($ov_str);
        if (strpos($ov_str, '.') !== false) {
            $parts = explode('.', $ov_str);
            return intval($parts[0]) + (intval($parts[1]) / 6);
        }
        return floatval($ov_str);
    }
}

if (!function_exists('sc_parse_score')) {
    function sc_parse_score($score_str) {
        if (empty($score_str)) return 0;
        $parts = explode('/', trim($score_str));
        return intval($parts[0]);
    }
}

if (!function_exists('sc_parse_wickets')) {
    function sc_parse_wickets($score_str) {
        if (empty($score_str)) return 0;
        $parts = explode('/', trim($score_str));
        return isset($parts[1]) ? intval($parts[1]) : 0;
    }
}

