if (!function_exists('sc_npl_shortcode')) {
    function sc_npl_shortcode() {
        $d   = sc_get();
        $sel = SC_NPL_SERIES;
        if (!isset($d['series'][$sel])) return '<div style="padding:40px;text-align:center;background:#fff8e5;border:1px solid #e0c88a;border-radius:8px;">NPL data not initialized.</div>';

        $info    = $d['series'][$sel];
        $teams   = $info['teams'] ?? array();
        $matches = array();
        foreach ($d['matches'] as $m) { if (($m['series'] ?? '') === $sel) $matches[] = $m; }

        $results  = array_filter($matches, function($m){ return !empty($m['winner']) || (!empty($m['team1_score']) && !empty($m['team2_score'])); });
        $fixtures = array_filter($matches, function($m){ return empty($m['winner']) && empty($m['team1_score']); });

        usort($results,  function($a,$b){ return strcmp($b['date']??'', $a['date']??''); });
        usort($fixtures, function($a,$b){ return strcmp($a['date']??'', $b['date']??''); });

        $table = sc_npl_points($d, $sel);

        $total_runs = 0; $total_wickets = 0; $total_matches_count = count($results);
        foreach ($results as $m) {
            if (!empty($m['team1_score'])) { $total_runs += sc_parse_score($m['team1_score']); $total_wickets += sc_parse_wickets($m['team1_score']); }
            if (!empty($m['team2_score'])) { $total_runs += sc_parse_score($m['team2_score']); $total_wickets += sc_parse_wickets($m['team2_score']); }
        }

        $all_players = array();
        foreach ($teams as $tn => $td) {
            foreach ($td['players'] ?? array() as $p) {
                if (!empty($p['name'])) $all_players[] = array_merge($p, array('team' => $tn, 'team_logo' => $td['logo'] ?? '', 'team_color' => $td['color'] ?? '#c8102e'));
            }
        }
        $all_players = sc_merge_players($all_players);
        $p0 = $all_players[0] ?? array('name' => 'Top Batsman');
        $p1 = $all_players[1] ?? array('name' => 'Top Bowler');
        $p2 = $all_players[2] ?? array('name' => 'All-Rounder');
        $p3 = $all_players[3] ?? array('name' => 'Wicket Keeper');

        // PHP 7.0+ safe fallback for array_key_first
        $team_keys_array = array_keys($teams);
        $fair_play_team = !empty($team_keys_array) ? $team_keys_array[0] : 'Team';

        ob_start();
        ?>
