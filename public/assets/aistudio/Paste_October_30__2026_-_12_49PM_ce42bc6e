if (!function_exists('sc_npl_points')) {
    function sc_npl_points($d, $series_name) {
        $t = array();
        $s = $d['series'][$series_name] ?? array();
        if (!empty($s['teams'])) {
            foreach ($s['teams'] as $row) {
                $t[$row['name']] = array(
                    'name' => $row['name'], 'logo' => $row['logo'],
                    'p' => 0, 'w' => 0, 'l' => 0, 't' => 0, 'nr' => 0, 'pts' => 0,
                    'nrr' => 0, 'runs_for' => 0, 'overs_for' => 0,
                    'runs_against' => 0, 'overs_against' => 0, 'wkts_taken' => 0
                );
            }
        }
        foreach ($d['matches'] as $m) {
            if (($m['series'] ?? '') !== $series_name) continue;
            if (!empty($m['live'])) continue;
            $t1 = $m['team1'] ?? ''; $t2 = $m['team2'] ?? '';
            if (empty($t1) || empty($t2)) continue;
            
            $w = trim($m['winner'] ?? '');
            $has_score = !empty($m['team1_score']) && !empty($m['team2_score']);
            if ($w === '' && !$has_score) continue;
            
            if (!isset($t[$t1])) $t[$t1] = array('name' => $t1, 'logo' => '', 'p' => 0, 'w' => 0, 'l' => 0, 't' => 0, 'nr' => 0, 'pts' => 0, 'nrr' => 0, 'runs_for' => 0, 'overs_for' => 0, 'runs_against' => 0, 'overs_against' => 0, 'wkts_taken' => 0);
            if (!isset($t[$t2])) $t[$t2] = array('name' => $t2, 'logo' => '', 'p' => 0, 'w' => 0, 'l' => 0, 't' => 0, 'nr' => 0, 'pts' => 0, 'nrr' => 0, 'runs_for' => 0, 'overs_for' => 0, 'runs_against' => 0, 'overs_against' => 0, 'wkts_taken' => 0);
            
            $t[$t1]['p']++; $t[$t2]['p']++;
            if (strcasecmp($w, 'NR') === 0 || strcasecmp($w, 'Abandoned') === 0) {
                $t[$t1]['nr']++; $t[$t2]['nr']++; $t[$t1]['pts']++; $t[$t2]['pts']++;
            } elseif (strcasecmp($w, 'Tie') === 0) {
                $t[$t1]['t']++; $t[$t2]['t']++; $t[$t1]['pts']++; $t[$t2]['pts']++;
            } elseif (strcasecmp($w, $t1) === 0) {
                $t[$t1]['w']++; $t[$t2]['l']++; $t[$t1]['pts'] += 2;
            } elseif (strcasecmp($w, $t2) === 0) {
                $t[$t2]['w']++; $t[$t1]['l']++; $t[$t2]['pts'] += 2;
            }
            
            if ($has_score && strcasecmp($w, 'NR') !== 0 && strcasecmp($w, 'Abandoned') !== 0) {
                $r1 = sc_parse_score($m['team1_score']); $o1 = sc_parse_overs($m['team1_overs']); $w1 = sc_parse_wickets($m['team1_score']);
                $r2 = sc_parse_score($m['team2_score']); $o2 = sc_parse_overs($m['team2_overs']); $w2 = sc_parse_wickets($m['team2_score']);
                if ($o1 > 0 && $o2 > 0) {
                    $t[$t1]['runs_for'] += $r1; $t[$t1]['overs_for'] += $o1; $t[$t1]['runs_against'] += $r2; $t[$t1]['overs_against'] += $o2; $t[$t1]['wkts_taken'] += $w2;
                    $t[$t2]['runs_for'] += $r2; $t[$t2]['overs_for'] += $o2; $t[$t2]['runs_against'] += $r1; $t[$t2]['overs_against'] += $o1; $t[$t2]['wkts_taken'] += $w1;
                }
            }
        }
        foreach ($t as &$row) {
            if ($row['overs_for'] > 0 && $row['overs_against'] > 0) {
                $row['nrr'] = ($row['runs_for'] / $row['overs_for']) - ($row['runs_against'] / $row['overs_against']);
            }
        }
        unset($row);
        usort($t, function ($a, $b) {
            if ($a['pts'] !== $b['pts']) return $b['pts'] - $a['pts'];
            if ($a['w'] !== $b['w']) return $b['w'] - $a['w'];
            if (abs($a['nrr'] - $b['nrr']) > 0.0001) return $b['nrr'] <=> $a['nrr'];
            if ($a['wkts_taken'] !== $b['wkts_taken']) return $b['wkts_taken'] - $a['wkts_taken'];
            return strcasecmp($a['name'], $b['name']);
        });
        return $t;
    }
}

